# ─────────────────────────────────────────────────────────────
#  The Lead Story — optional server settings
#  Everything has a sensible default, so this file is optional.
#  Copy to server/.env only if you need to change something.
# ─────────────────────────────────────────────────────────────

# Port for the API (and for the whole site in production)
PORT=4000

# Address to listen on. Behind Nginx or another reverse proxy, use 127.0.0.1
# HOST=127.0.0.1

# Folder where the database file (lead-story.db) is stored.
# Default: server/data. On a hosting service, point this at a persistent disk.
# DATA_DIR=/var/data

# Session signing secret. If unset, one is generated and stored in the database.
# JWT_SECRET=

# How long the admin stays signed in, in days
SESSION_DAYS=30
